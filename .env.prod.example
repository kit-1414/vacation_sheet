# Both application images receive these tags from the pull request workflow.
IMAGE_TAG=pr-123

POSTGRES_DB=vacation_sheet_db
POSTGRES_USER=vacation_sheet
POSTGRES_PASSWORD=replace-with-a-strong-password
YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret

# Do not add a trailing slash. Use the public HTTPS URL registered in Yandex OAuth.
APP_FRONTEND_URL=https://vacation.example.com
ALLOWED_EMAIL_DOMAIN=example.com
SESSION_COOKIE_SECURE=true
HTTP_PORT=80
